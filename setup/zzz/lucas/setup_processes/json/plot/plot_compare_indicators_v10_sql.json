{
  "process": [
    {
      "process": "add_process",
      "overwrite": false,
      "parameters": {
        "root_process": "plot",
        "process": "plot_compare_indicators",
        "min_user_stratum": 1,
        "title": "Plot indicators",
        "label": "Plot indicators."
      },
      "nodes": [
        {
          "parent": "process",
          "element": "parameters",
          "parameter": [
            {
              "parameter": "project_root_fp",
              "parameter_type": "text",
              "required": false,
              "default_value": "",
              "hint": "The root fp of the project"
            },
            {
              "parameter": "indicator_array",
              "parameter_type": "array",
              "required": false,
              "default_value": "",
              "hint": "Comma separated list of the indicators to plot"
            },
            {
              "parameter": "covariate_array",
              "parameter_type": "array",
              "required": false,
              "default_value": "",
              "hint": "Comma separated list of the covariates to plot; nominal (class) covariates are plotted as class counts"
            },
            {
              "parameter": "max_classes",
              "parameter_type": "integer",
              "required": false,
              "default_value": 15,
              "hint": "Max number of classes shown per nominal covariate; the remaining classes are summed as other"
            },
            {
              "parameter": "class_label",
              "parameter_type": "text",
              "required": false,
              "default_value": "display_name",
              "hint": "Label of class covariates (land cover, land use, biogeo16) in plots: display_name, tag, name or alias"
            },
            {
              "parameter": "targetfeaturesymbols",
              "parameter_type": "text",
              "required": false,
              "default_value": "default",
              "hint": "The name of JSON file defining the symbolisation of the indicators"
            },
            {
              "parameter": "standardisation",
              "parameter_type": "text",
              "required": false,
              "default_value": "default",
              "hint": "Indicator standardisation applied before plotting, default applies a predefined standardisation set for each indicator, none skips all standardisation."
            },
            {
              "parameter": "transformation",
              "parameter_type": "text",
              "required": false,
              "default_value": "default",
              "hint": "Indicator transformation applied before plotting, default applies a predefined transformation set for each indicator, none skips all transformations."
            },
            {
              "parameter": "benchmark",
              "parameter_type": "text",
              "required": false,
              "default_value": "raw",
              "hint": "Indicator benchmark to compare the standardisation/transformation against; alloswed values: raw, standardisation or transformation."
            },
            {
              "parameter": "only_plot_different",
              "parameter_type": "boolean",
              "required": false,
              "default_value": true,
              "hint": "Whether to only plot indicators that have a different standardisation/transformation in the benchmark and the settings in the standardisation/transformation."
            },
            {
              "parameter": "boxplot",
              "parameter_type": "boolean",
              "required": false,
              "default_value": true,
              "hint": "True for plotting boxplot diagrams, false not to"
            },
            {
              "parameter": "histogram",
              "parameter_type": "boolean",
              "required": false,
              "default_value": true,
              "hint": "True or false if you want a histogram plot"
            },
            {
              "parameter": "single_canvas_plot",
              "parameter_type": "boolean",
              "required": false,
              "default_value": false,
              "hint": "True or false if you want all paired comparison plots on a single canvas"
            },
            {
              "parameter": "individual_canvas_plot",
              "parameter_type": "boolean",
              "required": false,
              "default_value": true,
              "hint": "True or false if you want each paired comparison plot on an individual canvas"
            },
            {
              "parameter": "show",
              "parameter_type": "boolean",
              "required": false,
              "default_value": true,
              "hint": "True or false if you want to show the plot on screen"
            },
            {
              "parameter": "save",
              "parameter_type": "boolean",
              "required": false,
              "default_value": false,
              "hint": "True or false if you want to save the plot to file"
            }
          ]
        }
      ]
    }
  ]
}
