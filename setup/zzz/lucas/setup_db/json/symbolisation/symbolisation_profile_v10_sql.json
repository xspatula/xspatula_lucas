{
  "process": [
    {
      "process_id": "create_table",
      "overwrite": false,
      "delete": false,
      "parameters": {
        "schema": "symbolisation",
        "table": "indicator_symbolisation",
        "command": [
          "id SERIAL",
          "indicator_id REFERENCES observation_utility.indicator (id)",
          "color_id REFERENCES utility.color (id)",
          "fill_id REFERENCES utility.fill (id)",
          "gradient_id REFERENCES utility.gradient (id) DEFAULT 1",
          "line_width FLOAT",
          "line_color_id REFERENCES utility.color (id) DEFAULT 1",
          "line_pattern_id REFERENCES utility.line_pattern (id) DEFAULT 1",
          "symbol_id REFERENCES utility.symbol (id) DEFAULT 1",
          "point_id REFERENCES utility.point (id) DEFAULT 1",
          "short_label TEXT",
          "long_label TEXT",
          "theme TEXT",
          "UNIQUE (indicator_id, theme)",
          "PRIMARY KEY (id)"
        ]
      },
      "audit": {
        "INSERT": true,
        "UPDATE": true,
        "DELETE": true
      }
    }
  ]
}
